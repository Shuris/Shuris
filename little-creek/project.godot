; Engine configuration file.
; Little Creek — mobile prototype (Godot 4.7)

config_version=5

[application]

config/name="Little Creek"
config/description="Um pequeno riacho para cuidar e ver florescer."
config/version="0.5.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/sprites/ui/icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="LittleCreek"
boot_splash/bg_color=Color(0.0470588, 0.0941176, 0.12549, 1)
boot_splash/show_image=false

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

GameData="*res://scripts/autoload/GameData.gd"
GameState="*res://scripts/autoload/GameState.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
SaveSystem="*res://scripts/autoload/SaveSystem.gd"
Settings="*res://scripts/autoload/Settings.gd"
Clock="*res://scripts/autoload/Clock.gd"
Weather="*res://scripts/autoload/Weather.gd"
NatureLog="*res://scripts/autoload/NatureLog.gd"


[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/size/window_width_override=1920
window/size/window_height_override=1080
window/size/resizable=true

[gui]

theme/custom_font="res://assets/fonts/PixelifySans.ttf"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.0470588, 0.0941176, 0.12549, 1)
textures/vram_compression/import_etc2_astc=true

[shader_globals]

season_autumn={
"type": "float",
"value": 0.0
}
season_bare={
"type": "float",
"value": 0.0
}
season_winter={
"type": "float",
"value": 0.0
}
season_bloom={
"type": "float",
"value": 0.0
}
season_lush={
"type": "float",
"value": 0.0
}
season_young={
"type": "float",
"value": 0.0
}
snow_cover={
"type": "float",
"value": 0.0
}
world_wind={
"type": "float",
"value": 0.25
}
season_noise={
"type": "sampler2D",
"value": "res://assets/sprites/effects/noise_rgba.png"
}
