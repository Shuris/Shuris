<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/nm_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:maxLines="1" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
    <ImageView android:id="@+id/nm_face1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
        android:padding="2dp" android:scaleType="fitCenter" android:contentDescription="Péssimo"/>
    <ImageView android:id="@+id/nm_face2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
        android:padding="2dp" android:scaleType="fitCenter" android:contentDescription="Ruim"/>
    <ImageView android:id="@+id/nm_face3" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
        android:padding="2dp" android:scaleType="fitCenter" android:contentDescription="Neutro"/>
    <ImageView android:id="@+id/nm_face4" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
        android:padding="2dp" android:scaleType="fitCenter" android:contentDescription="Bom"/>
    <ImageView android:id="@+id/nm_face5" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
        android:padding="2dp" android:scaleType="fitCenter" android:contentDescription="Excelente"/>
    </LinearLayout>
</LinearLayout>
