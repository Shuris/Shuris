# Configuração do APP (opcional). Nada aqui é segredo: a chave da Riot fica
# somente no backend, em server/.env — nunca neste arquivo nem no código do app.

# Modo inicial: "demo" (padrão) ou "riot". Também pode ser trocado dentro do app,
# em Perfil → Fonte de dados.
# EXPO_PUBLIC_DATA_SOURCE=riot

# Endereço do backend. Em desenvolvimento não é necessário: o app usa o IP do
# computador que está servindo o Expo, na porta 3333.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:3333
