# Variáveis da versão web e do app (lidas no momento do build pelo Expo).
# Copie para ".env" (não versionado). Nenhuma chave secreta vai aqui: tudo que
# começa com EXPO_PUBLIC_ fica visível no código entregue ao navegador.

# Endereço público do backend (HTTPS em produção). Sem ele, o navegador usa
# http://<host da página>:3333, o que só serve em desenvolvimento.
EXPO_PUBLIC_API_BASE_URL=

# Fonte de dados inicial para visitantes: demo (padrão) ou riot.
EXPO_PUBLIC_DATA_SOURCE=demo

# "mobile" gera a versão web com as telas do celular (testes de compatibilidade).
EXPO_PUBLIC_WEB_LAYOUT=
