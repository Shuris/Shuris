# Copie este arquivo para ".env" (que NÃO é versionado) e preencha a chave.
# Gere a chave em https://developer.riotgames.com/ — chaves de desenvolvimento expiram em 24 h.
RIOT_API_KEY=

# Porta e interface do servidor. 0.0.0.0 permite acesso pelo celular na mesma rede.
PORT=3333
HOST=0.0.0.0

# Arquivo do banco SQLite.
DATABASE_FILE=./data/lolinsight.db

# Limites de aplicação da chave, no formato "requisições:segundos".
# Padrão das chaves de desenvolvimento: 20 a cada 1 s e 100 a cada 120 s.
RIOT_RATE_LIMITS=20:1,100:120

# Idioma dos nomes vindos do Data Dragon.
DDRAGON_LOCALE=pt_BR

# ---- Contas de usuário ----
# Segredo do servidor (HMAC dos códigos de e-mail e chave dos tokens do RSO), com 32+ caracteres.
# Se ficar vazio, um segredo aleatório é gerado em data/auth-secret na primeira execução.
# Trocar este valor invalida códigos de e-mail pendentes e tokens do RSO guardados.
AUTH_SECRET=

# E-mail: hoje só existe o modo de desenvolvimento. Nenhum e-mail é enviado; os códigos de
# confirmação e de redefinição de senha aparecem no terminal do servidor. Um provedor real
# (SMTP, Amazon SES, Resend...) é um serviço externo a ser configurado em src/auth/mailer.ts.

# ---- Riot Sign On (RSO) — só após aprovação da aplicação pela Riot ----
# Deixe em branco até a Riot aprovar a aplicação e fornecer as credenciais.
RSO_CLIENT_ID=
RSO_CLIENT_SECRET=
RSO_REDIRECT_URI=
# Emissor OIDC informado pela Riot (os endereços de autorização e token vêm da descoberta OIDC).
RSO_ISSUER=
# Endpoint que devolve a conta Riot do token de acesso, conforme a documentação da Riot.
RSO_ACCOUNT_URL=

# ---- Publicação ----
# Origens da versão web autorizadas a chamar a API (CORS), separadas por vírgula.
# "*" (padrão) aceita qualquer origem: use só em desenvolvimento.
ALLOWED_ORIGINS=*
# 1 quando o servidor estiver atrás de um proxy HTTPS (Nginx, Render, Fly...), para o
# limite de tentativas usar o IP real do cliente (cabeçalho X-Forwarded-For).
TRUST_PROXY=0
