{
  "name": "lol-insight-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend do LOL Insight: proxy seguro para a Riot Games API, com cache, banco SQLite e controle de rate limit.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
